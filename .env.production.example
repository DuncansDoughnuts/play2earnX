# Public browser configuration
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_RPC_URL=https://your-production-rpc.example
NEXT_PUBLIC_ALCHEMY_ID=
NEXT_PUBLIC_PROJECT_ID=

# Server-only authentication
NEXTAUTH_URL=https://your-production-domain.example
NEXTAUTH_SECRET=

# Contract deployment is intentionally separate from web deployment.
# Never expose private keys as NEXT_PUBLIC_* variables.
BITFINITY_RPC_URL=https://testnet.bitfinity.network
BITFINITY_PRIVATE_KEY=
